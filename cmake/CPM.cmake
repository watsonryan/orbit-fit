include_guard(GLOBAL)
set(_orbitfit_cpm_version 0.40.2)
set(_orbitfit_cpm_hash c8cdc32c03816538ce22781ed72964dc864b2a34a310d3b7104812a5ca2d835d)
if(CPM_SOURCE_CACHE)
  set(_orbitfit_cpm_root "${CPM_SOURCE_CACHE}/cpm")
elseif(DEFINED ENV{CPM_SOURCE_CACHE})
  set(_orbitfit_cpm_root "$ENV{CPM_SOURCE_CACHE}/cpm")
else()
  set(_orbitfit_cpm_root "${CMAKE_BINARY_DIR}/cmake")
endif()
set(_orbitfit_cpm "${_orbitfit_cpm_root}/CPM_${_orbitfit_cpm_version}.cmake")
file(MAKE_DIRECTORY "${_orbitfit_cpm_root}")
set(_orbitfit_cpm_size 0)
if(EXISTS "${_orbitfit_cpm}")
  file(SIZE "${_orbitfit_cpm}" _orbitfit_cpm_size)
endif()
if(_orbitfit_cpm_size EQUAL 0)
  file(DOWNLOAD "https://github.com/cpm-cmake/CPM.cmake/releases/download/v${_orbitfit_cpm_version}/CPM.cmake"
    "${_orbitfit_cpm}.download" STATUS _orbitfit_download_status TLS_VERIFY ON)
  list(GET _orbitfit_download_status 0 _orbitfit_download_code)
  if(NOT _orbitfit_download_code EQUAL 0)
    message(FATAL_ERROR "CPM download failed: ${_orbitfit_download_status}")
  endif()
  file(SHA256 "${_orbitfit_cpm}.download" _orbitfit_download_hash)
  if(NOT _orbitfit_download_hash STREQUAL _orbitfit_cpm_hash)
    message(FATAL_ERROR "Downloaded CPM.cmake does not match the pinned SHA256")
  endif()
  file(RENAME "${_orbitfit_cpm}.download" "${_orbitfit_cpm}")
endif()
file(SHA256 "${_orbitfit_cpm}" _orbitfit_actual_hash)
if(NOT _orbitfit_actual_hash STREQUAL _orbitfit_cpm_hash)
  message(FATAL_ERROR "Cached CPM.cmake does not match the pinned SHA256")
endif()
include("${_orbitfit_cpm}")
