# @file check_links.cmake
# @brief Reject missing local links and assets in the generated offline HTML reference.
# @author watson
cmake_minimum_required(VERSION 3.28)
if(NOT DEFINED HTML_ROOT)
  message(FATAL_ERROR "Pass -DHTML_ROOT=... for the generated Doxygen HTML directory")
endif()
file(GLOB pages "${HTML_ROOT}/*.html")
if(NOT pages)
  message(FATAL_ERROR "No generated HTML pages found")
endif()
foreach(page IN LISTS pages)
  file(READ "${page}" html)
  string(REGEX MATCHALL "(href|src)=\"[^\"]+\"" links "${html}")
  list(REMOVE_DUPLICATES links)
  foreach(link IN LISTS links)
    string(REGEX REPLACE "^[^=]+=\"|\"$" "" target "${link}")
    if(target MATCHES "^(#|https?:|mailto:|javascript:|data:|//)")
      continue()
    endif()
    string(REGEX REPLACE "[?#].*$" "" target "${target}")
    if(NOT EXISTS "${HTML_ROOT}/${target}")
      message(FATAL_ERROR "Missing local documentation link in ${page}: ${target}")
    endif()
  endforeach()
endforeach()
message(STATUS "Generated HTML links and local assets are present")
