# @file cli_example.cmake
# @brief Verify command-line output, identity handling, and serialized accuracy gates.
# @author watson
file(REMOVE_RECURSE "${OUTPUT}")
file(MAKE_DIRECTORY "${OUTPUT}")
execute_process(COMMAND "${CLI}" example --output "${OUTPUT}/request.json" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Example generation failed: ${status}")
endif()
execute_process(COMMAND "${CLI}" fit --input "${OUTPUT}/request.json" --output-dir "${OUTPUT}/fit"
  RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Example fitting failed: ${status}")
endif()
foreach(name elements.omm.json elements.tle report.json request.json)
  if(NOT EXISTS "${OUTPUT}/fit/${name}")
    message(FATAL_ERROR "Missing output ${name}")
  endif()
endforeach()
file(READ "${OUTPUT}/fit/report.json" report)
string(JSON accepted GET "${report}" continuous_accepted)
string(JSON tle_accepted GET "${report}" serialized_tle accepted)
string(JSON omm_accepted GET "${report}" serialized_omm accepted)
string(JSON overall GET "${report}" accepted)
string(JSON schema GET "${report}" schema)
if(NOT accepted OR NOT tle_accepted OR NOT omm_accepted OR NOT overall OR NOT schema STREQUAL "orbit-fit.report.v2")
  message(FATAL_ERROR "Exported example was not accepted")
endif()
string(JSON derivatives GET "${report}" fit derivatives)
if(NOT derivatives STREQUAL "automatic")
  message(FATAL_ERROR "The default derivative method must be automatic")
endif()
string(JSON optimizer GET "${report}" model optimizer)
string(JSON ceres_version GET "${report}" model ceres_version)
if(NOT optimizer STREQUAL "Ceres LM / DENSE_QR" OR ceres_version STREQUAL "")
  message(FATAL_ERROR "The report must identify the Ceres estimation backend")
endif()
execute_process(COMMAND "${CLI}" fit --input "${OUTPUT}/request.json" --output-dir "${OUTPUT}/fit"
  RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
if(NOT status EQUAL 1)
  message(FATAL_ERROR "Existing output must be protected")
endif()

# The continuous synthetic solution passes a 1 m gate, but its rounded TLE does not.
file(READ "${OUTPUT}/request.json" request)
string(JSON numerical SET "${request}" fit derivatives "\"finite_difference\"")
file(WRITE "${OUTPUT}/numerical.json" "${numerical}")
execute_process(COMMAND "${CLI}" fit --input "${OUTPUT}/numerical.json" --output-dir "${OUTPUT}/numerical"
  RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Explicit numerical derivative mode failed")
endif()
file(READ "${OUTPUT}/numerical/report.json" numerical_report)
string(JSON derivatives GET "${numerical_report}" fit derivatives)
if(NOT derivatives STREQUAL "finite_difference")
  message(FATAL_ERROR "The report must identify the selected derivative method")
endif()
string(JSON tight SET "${request}" fit maximum_rms_position_m 1)
file(WRITE "${OUTPUT}/tight.json" "${tight}")
execute_process(COMMAND "${CLI}" fit --input "${OUTPUT}/tight.json" --output-dir "${OUTPUT}/tight"
  RESULT_VARIABLE status)
if(NOT status EQUAL 2)
  message(FATAL_ERROR "Serialized accuracy failure must reject the deliverable")
endif()
file(READ "${OUTPUT}/tight/report.json" report)
string(JSON continuous GET "${report}" continuous_accepted)
string(JSON serialized GET "${report}" serialized_tle accepted)
string(JSON overall GET "${report}" accepted)
string(JSON reason GET "${report}" reason)
if(NOT continuous OR serialized OR overall OR NOT reason STREQUAL "tle_rejected")
  message(FATAL_ERROR "Continuous and serialized acceptance must remain separate")
endif()

# Six-digit identity must remain intact in OMM without inventing a TLE catalog ID.
string(JSON large SET "${request}" metadata catalog_number 100001)
file(WRITE "${OUTPUT}/large.json" "${large}")
execute_process(COMMAND "${CLI}" fit --input "${OUTPUT}/large.json" --output-dir "${OUTPUT}/large"
  RESULT_VARIABLE status)
if(NOT status EQUAL 2 OR EXISTS "${OUTPUT}/large/elements.tle")
  message(FATAL_ERROR "The default policy must reject a missing required TLE")
endif()
file(READ "${OUTPUT}/large/report.json" report)
string(JSON overall GET "${report}" accepted)
string(JSON reason GET "${report}" reason)
if(overall OR NOT reason STREQUAL "tle_unavailable")
  message(FATAL_ERROR "The report must agree with the required-TLE exit decision")
endif()
execute_process(COMMAND "${CLI}" fit --product-policy omm-sufficient --output-dir "${OUTPUT}/omm-only"
  --input "${OUTPUT}/large.json" RESULT_VARIABLE status)
if(NOT status EQUAL 0 OR EXISTS "${OUTPUT}/omm-only/elements.tle")
  message(FATAL_ERROR "Large catalog IDs require accepted OMM-only output")
endif()
file(READ "${OUTPUT}/omm-only/elements.omm.json" omm)
string(JSON identity GET "${omm}" NORAD_CAT_ID)
if(NOT identity EQUAL 100001)
  message(FATAL_ERROR "Catalog identity was changed")
endif()
file(READ "${OUTPUT}/omm-only/report.json" report)
string(JSON overall GET "${report}" accepted)
string(JSON policy GET "${report}" product_policy)
if(NOT overall OR NOT policy STREQUAL "omm_sufficient")
  message(FATAL_ERROR "The report must record the explicit OMM delivery policy")
endif()

# Failed input and malformed arguments must leave neither final output nor owned staging.
execute_process(COMMAND "${CLI}" fit --input "${OUTPUT}/missing.json" --output-dir "${OUTPUT}/missing"
  RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
file(GLOB leftovers "${OUTPUT}/missing.tmp-*")
if(NOT status EQUAL 1 OR EXISTS "${OUTPUT}/missing" OR leftovers)
  message(FATAL_ERROR "Input failure left output or owned staging")
endif()
foreach(extra "--unknown;x" "--product-policy;invalid" "--input;duplicate")
  execute_process(COMMAND "${CLI}" fit --input "${OUTPUT}/request.json" --output-dir "${OUTPUT}/invalid" ${extra}
    RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
  if(NOT status EQUAL 1 OR EXISTS "${OUTPUT}/invalid")
    message(FATAL_ERROR "Invalid options must fail before creating output")
  endif()
endforeach()
