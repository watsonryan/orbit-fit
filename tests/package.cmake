# @file package.cmake
# @brief Install, relocate, audit, and test a standalone package plus a portable consumer archive.
# @author watson
cmake_minimum_required(VERSION 3.28)
foreach(required BINARY_DIR SOURCE_DIR GENERATOR CONFIG)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Missing ${required}")
  endif()
endforeach()
set(work "${BINARY_DIR}/package-check")
if(EXISTS "${work}" AND NOT EXISTS "${work}/.orbitfit-owned")
  message(FATAL_ERROR "Refusing to replace an unowned package-check directory")
endif()
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}/relocated artifact")
file(WRITE "${work}/.orbitfit-owned" "Generated by orbit-fit tests/package.cmake\n")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${BINARY_DIR}" --config "${CONFIG}"
  --prefix "${work}/original-prefix" RESULT_VARIABLE status
  OUTPUT_FILE "${work}/install.log" ERROR_FILE "${work}/install-errors.log")
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Installation failed; see ${work}/install-errors.log")
endif()
set(artifact "${work}/relocated artifact")
set(prefix "${artifact}/prefix")
file(RENAME "${work}/original-prefix" "${prefix}")
file(COPY "${SOURCE_DIR}/tests/consumer" DESTINATION "${artifact}")

# Catch hard-coded dependency/build/cache paths even when those trees still exist
# on a local developer machine. CI consumes the archive on a separate clean runner.
file(GLOB_RECURSE exports "${prefix}/*.cmake")
foreach(export IN LISTS exports)
  file(READ "${export}" text)
  string(REPLACE "\\" "/" text "${text}")
  foreach(forbidden "${SOURCE_DIR}" "${BINARY_DIR}" "${CPM_CACHE}" "${work}/original-prefix")
    if(NOT forbidden STREQUAL "")
      file(TO_CMAKE_PATH "${forbidden}" forbidden)
      string(FIND "${text}" "${forbidden}/" found)
      if(NOT found EQUAL -1)
        message(FATAL_ERROR "Non-relocatable export: ${export} contains ${forbidden}")
      endif()
    endif()
  endforeach()
endforeach()
set(configure "${CMAKE_COMMAND}" -S "${artifact}/consumer" -B "${work}/consumer-build" -G "${GENERATOR}"
  "-DCMAKE_BUILD_TYPE=${CONFIG}" "-DCMAKE_PREFIX_PATH=${prefix}" "-DORBITFIT_ALLOWED_PREFIX=${prefix}"
  -DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF -DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY=OFF
  -DCMAKE_FIND_USE_CMAKE_ENVIRONMENT_PATH=OFF)
if(COMPILER)
  list(APPEND configure "-DCMAKE_CXX_COMPILER=${COMPILER}")
endif()
if(PLATFORM)
  list(APPEND configure -A "${PLATFORM}")
endif()
if(TOOLSET)
  list(APPEND configure -T "${TOOLSET}")
endif()
execute_process(COMMAND ${configure} COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${work}/consumer-build" --config "${CONFIG}" --parallel 2
  COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_CTEST_COMMAND}" --test-dir "${work}/consumer-build" -C "${CONFIG}"
  --output-on-failure COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar czf "${work}/orbitfit-package.tar.gz" prefix consumer
  WORKING_DIRECTORY "${artifact}" COMMAND_ERROR_IS_FATAL ANY)
message(STATUS "Relocated package passed; clean-runner archive: ${work}/orbitfit-package.tar.gz")
